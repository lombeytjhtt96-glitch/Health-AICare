# Environment Configuration
APP_NAME=Health-AICare Backend
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_secret_key_in_production

# Database Settings
# For PostgreSQL in production: postgresql+asyncpg://user:password@localhost:5432/health_ai_db
# For SQLite local development: sqlite+aiosqlite:///./health_ai.db
DATABASE_URL=sqlite+aiosqlite:///./health_ai.db

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# LLM Backbone (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-3-flash
GEMINI_PRO_MODEL=gemini-3-pro

# Web3 / Blockchain Settings
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_CHAIN_ID=97
SOMNIA_TESTNET_RPC=https://somnia-testnet.rpc.caldera.xyz/http
SOMNIA_CHAIN_ID=50312
PLATFORM_WALLET_PRIVATE_KEY=your_private_key_here
ATTESTATION_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
BADGES_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
